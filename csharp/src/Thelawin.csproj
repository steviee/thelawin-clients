<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>Thelawin</RootNamespace>

    <PackageId>Thelawin</PackageId>
    <Version>0.2.0</Version>
    <Authors>thelawin.dev</Authors>
    <Description>Official .NET SDK for thelawin.dev - Generate ZUGFeRD/Factur-X/XRechnung/Peppol/FatturaPA e-invoices</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://thelawin.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/steviee/thelawin-clients</RepositoryUrl>
    <PackageTags>thelawin;zugferd;factur-x;xrechnung;peppol;fatturapa;invoice;pdf;e-invoice;eu;en16931</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

</Project>
